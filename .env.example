# Copy this file to .env.local (gitignored) and fill in real values.

# Backend base URLs -- not committed to git, see src/utils/urls.ts
EXPO_PUBLIC_API_BASE_URL_PROD=
EXPO_PUBLIC_API_BASE_URL_QA=

# "production" uses EXPO_PUBLIC_API_BASE_URL_PROD; anything else (or unset) uses QA.
EXPO_PUBLIC_API_ENV=qa
