# Copy this file to .env.local (gitignored) and fill in real values.

# Application environment switch: "development" | "qa" | "production"
# - "development": Local Metro / Expo Go / Dev Client (uses QA URLs by default)
# - "qa": EAS Preview release builds (uses QA URLs)
# - "production": EAS Production release builds (strictly requires valid HTTPS PROD URLs)
EXPO_PUBLIC_APP_ENV=development

# Backend API base URLs
EXPO_PUBLIC_API_BASE_URL_QA=https://qa-api.caresure.codeneptune.com
EXPO_PUBLIC_API_BASE_URL_PROD=https://api.caresure.com

# Public web store origin used to build shareable product links & App Links / Universal Links
EXPO_PUBLIC_WEB_BASE_URL_QA=https://qa-caresure.codeneptune.com
EXPO_PUBLIC_WEB_BASE_URL_PROD=https://caresure.com
