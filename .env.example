# Copy this file to .env.local (gitignored) and fill in real values.

# Backend base URLs -- not committed to git, see src/utils/urls.ts
EXPO_PUBLIC_API_BASE_URL_PROD=
EXPO_PUBLIC_API_BASE_URL_QA=

# "production" uses EXPO_PUBLIC_API_BASE_URL_PROD; anything else (or unset) uses QA.
EXPO_PUBLIC_API_ENV=qa

# Public web store origin used to build shareable product links. Follows the
# same LIVE switch as the API. If unset, falls back to the QA host — but PROD
# MUST be set before a production build or shares will point at QA.
EXPO_PUBLIC_WEB_BASE_URL_PROD=
EXPO_PUBLIC_WEB_BASE_URL_QA=https://qa-caresure.codeneptune.com
