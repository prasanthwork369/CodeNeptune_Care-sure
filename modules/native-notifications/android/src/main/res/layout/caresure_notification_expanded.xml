<?xml version="1.0" encoding="utf-8"?>
<!--
  CareSure Custom Expanded Rich Notification (Apollo 24/7 Style)
  Hierarchy:
    - Top: Title + 2-line Description on the left; Orange Live Countdown on the right
    - Middle: Full-width Campaign Banner Image (2:1 aspect ratio)
    - Bottom: Action CTA Text ("Check Now")
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/caresure_notif_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="10dp">

    <!-- Top Text & Countdown Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <!-- Left Column: Title & Description -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/caresure_notif_title"
                style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/caresure_notif_body"
                style="@style/TextAppearance.Compat.Notification.Line2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Right Column: Live Countdown Chronometer -->
        <Chronometer
            android:id="@+id/caresure_notif_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_gravity="top|end"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#F05423"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Middle Promotional Banner Image (Full-Width, ~2:1 Ratio) -->
    <ImageView
        android:id="@+id/caresure_notif_banner"
        android:layout_width="match_parent"
        android:layout_height="145dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- Bottom Action CTA ("Check Now") -->
    <TextView
        android:id="@+id/caresure_notif_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:paddingEnd="12dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1A73E8"
        android:text="Check Now"
        android:maxLines="1" />

</LinearLayout>
